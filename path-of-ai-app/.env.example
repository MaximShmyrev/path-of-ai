# Скопируй в .env и заполни при необходимости. .env в git НЕ коммитится.
# Без ключей приложение полностью работает на детерминированных фоллбэках:
#   - события: SeedBankAdapter (банк из seed)
#   - арты: PlaceholderAdapter (SVG-плейсхолдеры)

# --- Деплой (docker-compose.prod.yml) ---
# Порт, на котором nginx раздаёт приложение (фронтенд + /api прокси).
WEB_PORT=8080

# --- PostgreSQL ---
# В проде ОБЯЗАТЕЛЬНО смени пароль на сильный.
POSTGRES_USER=pathofai
POSTGRES_PASSWORD=pathofai
POSTGRES_DB=pathofai

# --- LLM-провайдер событий (GLM Coding Plan, Anthropic-совместимый) ---
# Пусто → события берутся из банка (source: "bank").
# GLM_BASE_URL: Anthropic-совместимый эндпоинт GLM Coding Plan (z.ai).
#   международный контур: https://api.z.ai/api/anthropic
#   китайский контур:     https://open.bigmodel.cn/api/anthropic
# Модель по умолчанию — glm-4.6 (см. app/story.py GlmAdapter.model).
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/anthropic

# --- Генерация рисованных артов (Flux через Replicate) ---
# Пусто → используются SVG-плейсхолдеры.
REPLICATE_API_TOKEN=
